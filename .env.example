# Copy this file to .env for local development (already gitignored -- never
# commit a real .env). Full explanation of every service and where to get
# each credential: docs/service_setup.md.
#
# This file covers local dev only. In production:
#   - The pipeline (scripts/run_stage.py) runs via GitHub Actions
#     (.github/workflows/pipeline.yml) using GitHub *repo secrets*, not this
#     file -- set the same variable names there under Settings -> Secrets and
#     variables -> Actions.
#   - The Discord bot (discord_bot/bot.py) runs on the VPS via Dokploy using
#     variables set in Dokploy's own env panel, not this file.

# --- This app's own auth (protects the FastAPI endpoints in main.py, which
# are no longer the active trigger path but are left in the repo) ---
API_KEY=your_custom_api_key

# --- Google Sheets (pipeline's database) ---
# Entire contents of your Google service account JSON key, as one line.
# See docs/service_setup.md section 2 for the required spreadsheets/worksheets.
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# --- LLM providers (used by the custom fallback runner) ---
GEMINI_API_KEY=your_gemini_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
COHERE_API_KEY=your_cohere_api_key

# --- Research / search ---
TAVILY_API_KEY=your_tavily_api_key
SERPAPI_KEY=your_serpapi_key

# --- Images ---
FREEPIC_API_KEY=your_freepik_api_key
HF_TOKEN=your_huggingface_token
PEXELS_API_KEY=your_pexels_api_key

# --- Sanity CMS ---
SANITY_PROJECT_ID=your_sanity_project_id
SANITY_DATASET=production
SANITY_API_TOKEN=your_sanity_write_token
SANITY_DEFAULT_AUTHOR_ID=your_author_document_id
SANITY_DEFAULT_AUTHOR_NAME="Your Author Name"

# --- Discord bot (discord_bot/bot.py) ---
# Only needed if you're running the bot locally for testing; in production
# these live in Dokploy's env panel, not here.
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_APPROVAL_CHANNEL_ID=123456789012345678
GITHUB_PAT=your_fine_grained_github_pat_with_actions_write
GITHUB_REPO=your-github-username/SEO-Blog-Agent

# --- Pipeline -> Discord notification ---
# Incoming webhook URL for the approval channel; scripts/run_stage.py posts
# draft-ready-for-review messages here after the "content" stage.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/yyyyy

# --- Defined in the code but not currently wired into any active agent/tool
# -- safe to leave unset unless you're working on the (unimplemented) YouTube
# research feature or the (unused) X/Twitter search tool. See
# docs/service_setup.md's "Quick reference" table for details. ---
# MINIMAX_API_KEY=
# X_API_BEARER_TOKEN=
# RAPID_API_YOUTUBE_TRANSCRIPT_API_KEY=
# YOUTUBE_TRANSCRIPT_IO_API_TOKEN=
# YOUTUBE_TRANSCRIPT_IO_API_TOKEN_2=
